meta {
  name: createUser
  type: graphql
  seq: 3
}

post {
  url: {{baseUrl}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:graphql {
  mutation {
    createUser(input: {
      username: "jdoe"
      firstName: "John"
      lastName: "Doe"
      email: "john@example.com"
      password: "SecurePass123!"
      roleId: "018f6b7a-0001-7000-8000-000000000003"
      projectId: "018f6b7a-0002-7000-8000-000000000001"
    }) {
      id username fullName email status
    }
  }
}
