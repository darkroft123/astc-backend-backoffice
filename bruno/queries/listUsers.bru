meta {
  name: listUsers
  type: graphql
  seq: 1
}

post {
  url: {{baseUrl}}
  body: graphql
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:graphql {
  query {
    listUsers(filter: { page: 0, size: 10 }) {
      items {
        id username fullName email status roleName projectName
      }
      pageInfo {
        page size totalCount totalPages hasNextPage
      }
    }
  }
}
